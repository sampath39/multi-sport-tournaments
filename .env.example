# ─────────────────────────────────────────────────────────
# Multi-Sport Tournament Management Platform
# Environment Configuration
# ─────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ─────────────────────────────────────────────────────────
# Database
# ─────────────────────────────────────────────────────────
POSTGRES_DB=tournament_platform
POSTGRES_USER=tournament_user
POSTGRES_PASSWORD=tournament_secret_2026

# ─────────────────────────────────────────────────────────
# Redis
# ─────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret_2026

# ─────────────────────────────────────────────────────────
# JWT Authentication
# ─────────────────────────────────────────────────────────
JWT_SECRET=change-this-to-a-256-bit-random-secret-key-in-production
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# ─────────────────────────────────────────────────────────
# Supabase (optional — for cloud PostgreSQL and Storage)
# ─────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_STORAGE_BUCKET=tournament-assets

# ─────────────────────────────────────────────────────────
# Spring Boot
# ─────────────────────────────────────────────────────────
SPRING_PROFILE=dev

# ─────────────────────────────────────────────────────────
# Frontend
# ─────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:8080

# ─────────────────────────────────────────────────────────
# Email (optional)
# ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_NAME=Tournament Platform
SMTP_FROM_EMAIL=noreply@tournamentplatform.com
